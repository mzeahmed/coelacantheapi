    "symfony/cache": "^7.0",
    "vlucas/phpdotenv": "^5.6"
  },
  "require-dev": {
    "fakerphp/faker": "^1.23",
    "phpro/grumphp": "^2.5",
    "phpstan/phpstan": "^1.10",
    "phpunit/phpunit": "^11.0",
    "roave/security-advisories": "dev-latest",
    "squizlabs/php_codesniffer": "^3.9",
    "symfony/var-dumper": "^7.0"
