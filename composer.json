  "require": {
    "php": "^8.3",
    "doctrine/migrations": "^3.7",
    "doctrine/orm": "^3.1",
    "firebase/php-jwt": "^6.10",
    "oscarotero/env": "^2.1",
    "php-di/php-di": "^7.0",
